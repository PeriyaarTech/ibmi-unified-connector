# Copy this file to .env in the repo root and fill in your IBM i values.
# These settings are only for local connectivity checks.

DB_SYSTEM=your-system.periyaartech.com
DB_USER=your-username
DB_PASSWORD=your-password
DB_MODE=auto
PGM_LIBRARY=YOURLIBRARY
TESTDB_CLP_LIBRARY=QGPL
TESTDB_CLP_PROGRAM=TESTDB

# Direct ODBC connection string used by the test utility.
ODBC_CONNECTION_STRING=DRIVER={IBM i Access ODBC Driver};SYSTEM=your-system.periyaartech.com;UID=your-username;PWD=your-password;DBQ=QTEMP,QGPL
