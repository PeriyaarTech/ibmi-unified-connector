{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GGI Programs Configuration",
  "description": "Schema for RPG program registry (programs.json)",
  "type": "object",
  "required": ["version", "programs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "_comment": { "type": "string" },
    "programs": {
      "type": "object",
      "description": "Map of program name to program definition",
      "additionalProperties": {
        "type": "object",
        "required": ["library", "params"],
        "properties": {
          "description": { "type": "string" },
          "library": {
            "type": "string",
            "description": "IBM i library name or ${ENV_VAR} placeholder"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Parameter name (uppercase, matches RPG field name)"
                },
                "type": {
                  "type": "string",
                  "description": "IBM i data type: e.g. 15p0 (packed), 1A (char), 9999A (long char), 10i0 (integer)"
                }
              }
            }
          }
        }
      }
    }
  }
}
